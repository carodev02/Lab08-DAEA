<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Biblioteca Aurea</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">BA</span><span>Biblioteca Aurea</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir navegación"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-controller="Libros" asp-action="Index">Libros</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Socios" asp-action="Index">Socios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Prestamos" asp-action="Reporte">Préstamos</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container app-main">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert app-alert alert-dismissible fade show" role="alert"><span>@mensaje</span><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
        }
        @RenderBody()
    </main>
    <footer class="app-footer"><div class="container d-flex flex-column flex-sm-row justify-content-between gap-2"><span>Biblioteca Aurea</span><span>Gestión clara, catálogo al día</span></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
