@model Biblioteca.Web.Models.Libro
@using Microsoft.AspNetCore.Mvc.Rendering
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid">
    <div class="field-group field-wide"><label asp-for="Titulo" class="form-label"></label><input asp-for="Titulo" class="form-control" autocomplete="off" /><span asp-validation-for="Titulo" class="text-danger"></span></div>
    <div class="field-group"><label asp-for="ISBN" class="form-label"></label><input asp-for="ISBN" class="form-control" autocomplete="off" /><span asp-validation-for="ISBN" class="text-danger"></span></div>
    <div class="field-group"><label asp-for="AutorId" class="form-label"></label><select asp-for="AutorId" asp-items="@(ViewData["Autores"] as SelectList)" class="form-select"><option value="0">Seleccionar autor</option></select><span asp-validation-for="AutorId" class="text-danger"></span></div>
    <div class="field-group"><label asp-for="Ejemplares" class="form-label"></label><input asp-for="Ejemplares" class="form-control" min="0" /><span asp-validation-for="Ejemplares" class="text-danger"></span></div>
</div>
