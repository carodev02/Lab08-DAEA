@model Biblioteca.Web.Models.Libro
@{ ViewData["Title"] = "Detalle del libro"; }
<div class="narrow-page"><a class="back-link" asp-action="Index">← Volver al catálogo</a><div class="detail-card"><div class="detail-cover"><span>BA</span></div><div class="detail-content"><span class="eyebrow">Ficha bibliográfica</span><h1>@Model.Titulo</h1><p class="detail-author">@Model.AutorNombre</p><dl class="detail-list"><div><dt>ISBN</dt><dd>@Model.ISBN</dd></div><div><dt>Ejemplares</dt><dd>@Model.Ejemplares</dd></div><div><dt>Estado</dt><dd><span class="status-badge status-active">Disponible</span></dd></div></dl><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.LibroId">Editar libro</a></div></div></div>
