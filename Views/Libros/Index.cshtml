@model IEnumerable<Biblioteca.Web.Models.Libro>
@{ ViewData["Title"] = "Catálogo de libros"; }
<div class="page-heading">
    <div><span class="eyebrow">Colección activa</span><h1>Catálogo de libros</h1><p>Encuentra títulos y mantén el inventario actualizado.</p></div>
    <a class="btn btn-primary" asp-action="Create">Nuevo libro</a>
</div>
<form method="get" class="search-panel" role="search">
    <label class="visually-hidden" for="buscar">Buscar por título</label><input id="buscar" name="buscar" class="form-control" value="@ViewData["Buscar"]" placeholder="Buscar por título" /><button class="btn btn-primary" type="submit">Buscar</button>
    @if (!string.IsNullOrWhiteSpace(ViewData["Buscar"]?.ToString())) { <a class="btn btn-ghost" asp-action="Index">Limpiar</a> }
</form>
<div class="table-shell"><div class="table-responsive"><table class="table app-table align-middle mb-0">
    <thead><tr><th>Libro</th><th>ISBN</th><th class="text-center">Ejemplares</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @if (Model.Any()) { @foreach (var libro in Model) { <partial name="_LibroFila" model="libro" /> } }
    else { <tr><td colspan="4" class="empty-state">No se encontraron libros activos.</td></tr> }
    </tbody>
</table></div></div>
