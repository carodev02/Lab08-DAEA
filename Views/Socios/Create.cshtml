@model Biblioteca.Web.Models.Socio
@{ ViewData["Title"] = "Nuevo socio"; }
<div class="narrow-page"><a class="back-link" asp-action="Index">← Volver a socios</a><div class="form-card"><div class="form-card-heading"><span class="eyebrow">Comunidad</span><h1>Nuevo socio</h1></div><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field-group"><label asp-for="DNI" class="form-label"></label><input asp-for="DNI" class="form-control" autocomplete="off" /><span asp-validation-for="DNI" class="text-danger"></span></div><div class="field-group field-wide"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" autocomplete="name" /><span asp-validation-for="Nombre" class="text-danger"></span></div><div class="field-group field-wide"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div></div><div class="form-actions"><a class="btn btn-ghost" asp-action="Index">Cancelar</a><button class="btn btn-primary" type="submit">Registrar socio</button></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
